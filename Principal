import java.util.Scanner;

public class Principal {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        ListaDoble lista = new ListaDoble();

        int opcion;

        do {

            System.out.println("\n===== LISTA DOBLEMENTE ENLAZADA =====");
            System.out.println("1. Insertar al inicio");
            System.out.println("2. Insertar al final");
            System.out.println("3. Mostrar de inicio a fin");
            System.out.println("4. Mostrar de fin a inicio");
            System.out.println("5. Buscar");
            System.out.println("6. Eliminar");
            System.out.println("7. Salir");
            System.out.print("Opción: ");

            opcion = sc.nextInt();

            switch (opcion) {

                case 1:
                    System.out.print("Dato: ");
                    lista.insertarInicio(sc.nextInt());
                    break;

                case 2:
                    System.out.print("Dato: ");
                    lista.insertarFinal(sc.nextInt());
                    break;

                case 3:
                    lista.mostrarAdelante();
                    break;

                case 4:
                    lista.mostrarAtras();
                    break;

                case 5:
                    System.out.print("Dato a buscar: ");
                    int buscar = sc.nextInt();

                    if (lista.buscar(buscar))
                        System.out.println("Dato encontrado.");
                    else
                        System.out.println("Dato no encontrado.");
                    break;

                case 6:
                    System.out.print("Dato a eliminar: ");
                    lista.eliminar(sc.nextInt());
                    break;

                case 7:
                    System.out.println("Programa finalizado.");
                    break;

                default:
                    System.out.println("Opción inválida.");
            }

        } while (opcion != 7);

        sc.close();
    }
}